# ── Supabase ────────────────────────────────────────────────────────────────
# Safe to expose to the browser (RLS is the security boundary):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never import in
# client components. Used only in scripts/ and server-side billing webhook code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev-only escape hatch: lets /api/billing/checkout flip subscription_status
# without a real payment provider. MUST be unset/false in production.
DEV_FAKE_CHECKOUT=true

# ── Stripe (wire in later — see lib/payments/) ──────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
