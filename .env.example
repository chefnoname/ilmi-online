# Template only — put REAL values in .env.local (gitignored).
# ⚠ Never commit real keys here: this file is tracked by git.

# ── Supabase ────────────────────────────────────────────────────────────────
# Safe to expose to the browser (RLS is the security boundary):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Accepts the new sb_secret_... key (SUPABASE_SECRET_KEY also works).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Subject featured in the dashboard Box Promo (defaults to aqeedah):
NEXT_PUBLIC_FEATURED_SUBJECT_SLUG=aqeedah

# ── Mux (signed playback) ───────────────────────────────────────────────────
# SERVER ONLY. Create a Signing Key in Mux: Settings → Signing Keys.
MUX_SIGNING_KEY_ID=your-signing-key-id
MUX_SIGNING_KEY_PRIVATE=base64-encoded-private-key-from-mux
# Optional — only needed if you script asset/upload management:
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────────────
# SERVER ONLY.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# The recurring Price for the subscription plan:
STRIPE_PRICE_ID=price_...

# Dev-only escape hatch: if STRIPE_SECRET_KEY is unset, the Subscribe button
# flips subscription_status directly (never runs in production builds).
DEV_FAKE_CHECKOUT=true
